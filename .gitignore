# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
cover/

# Jupyter Notebook checkpoints (DO NOT ignore notebooks themselves)
.ipynb_checkpoints/

# Environments
.env
.envrc
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE/editor caches
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
cython_debug/
.cursorignore
.cursorindexingignore

# OS / filesystem noise
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Ignore interim docs (work-in-progress, not shipped)
docs/interim/

# ------------------------------------------------------------
# Project-specific: ignore derived artefacts (reproducible),
# but TRACK the minimal CI + app-shipping bundle.
# ------------------------------------------------------------

# Ignore data by default
data/
!data/processed/

# Ignore everything under processed by default...
data/processed/*

# ...but keep minimal app/CI assets
!data/processed/ch5_assets/
!data/processed/ch5_assets/**

!data/processed/df_with_residuals.csv

!data/processed/skill_similarity_matrix/
!data/processed/skill_similarity_matrix/**

# If your pipeline expects these at runtime, track them too:
!data/processed/salary_model_dfv03_pca_jobid.csv
!data/processed/skill_prob_matrix.csv
!data/processed/ch2_processed_df.csv

# Models: ignore by default
models/
models/*

# ...but keep minimal inference artefacts for CI/app
!models/salary_model_v4.pkl
!models/skill_pca_v1.pkl

# Optional local outputs
logs/
reports/_build/
reports/figures/_build/
