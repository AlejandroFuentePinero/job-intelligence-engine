# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
cover/

# Jupyter Notebook checkpoints (DO NOT ignore notebooks themselves)
.ipynb_checkpoints/

# Environments
.env
.envrc
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE/editor caches
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
cython_debug/
.cursorignore
.cursorindexingignore

# OS / filesystem noise
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# Project-specific: ignore interim / archived docs (not shipped)
# ------------------------------------------------------------
docs/interim/
docs/archive/

# ------------------------------------------------------------
# Project-specific: ignore data folders that should not ship
# ------------------------------------------------------------
data/external/
data/interim/

# Optional local outputs
logs/
reports/_build/
reports/figures/_build/
